PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/crowdfundly
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:3000
# Comma-separated allowlist. Only these accounts are created as Admin accounts.
ADMIN_EMAILS=admin@example.com
# Required only when enabling secure credit purchases through Stripe Checkout.
STRIPE_SECRET_KEY=sk_test_replace_me
